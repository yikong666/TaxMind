# 应用
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=请设置高强度Root密码
MYSQL_USER=taxmind
MYSQL_PASSWORD=请设置高强度密码
MYSQL_DATABASE=taxmind
JWT_SECRET_KEY=请生成至少32位的随机字符串
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
CAPTCHA_EXPIRE_SECONDS=300

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=请设置高强度密码
REDIS_DB=0

# Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_DATABASE=taxmind
MILVUS_COLLECTION=taxmind_policy_chunks

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=taxmind_admin
MINIO_SECRET_KEY=请设置高强度密码
MINIO_BUCKET=taxmind-documents
MINIO_SECURE=false
MAX_UPLOAD_SIZE_MB=50
PARENT_CHUNK_SIZE=1200
CHILD_CHUNK_SIZE=300
CHUNK_OVERLAP=50

# 大模型与检索
DASHSCOPE_API_KEY=
LLM_MODEL=qwen3-max
LLM_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_PATH=data/models/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_DENSE_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_PATH=data/models/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RETRIEVAL_CANDIDATE_K=20
DEFAULT_TOP_K=5
DEFAULT_HISTORY_ROUNDS=5
FAQ_BM25_THRESHOLD=0.85
FAQ_CACHE_TTL_SECONDS=3600

# 官方数据批量导入（仅执行 import_official_data.py 时需要）
TAXMIND_API_URL=http://127.0.0.1:8000/api/v1
TAXMIND_ACCESS_TOKEN=
TAXMIND_KNOWLEDGE_BASE_ID=
