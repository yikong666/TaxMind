# 应用
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=taxmind
MYSQL_PASSWORD=请设置高强度密码
MYSQL_DATABASE=taxmind

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=请设置高强度密码
REDIS_DB=0

# Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_DATABASE=taxmind
MILVUS_COLLECTION=taxmind_policy_chunks

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=taxmind_admin
MINIO_SECRET_KEY=请设置高强度密码
MINIO_BUCKET=taxmind-documents
MINIO_SECURE=false

# 大模型与检索
DASHSCOPE_API_KEY=
LLM_MODEL=qwen3-max
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DEFAULT_TOP_K=5
DEFAULT_HISTORY_ROUNDS=5
FAQ_BM25_THRESHOLD=0.85
